    "title": "standard",
    "description": "## standard.GnosticExamplesService\n\nGnostic examples are YAML, so they can be mappings and sequences, reuse\n values through anchors and merge keys, and carry typed scalars. The YAML\n and JSON outputs render the same values.",
    "version": "1.0.0"
  },
  "paths": {
    "/standard.GnosticExamplesService/GetShipment": {
      "post": {
        "tags": [
          "standard.GnosticExamplesService"
        ],
        "summary": "GetShipment",
        "operationId": "standard.GnosticExamplesService.GetShipment",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "description": "Define the version of the Connect protocol",
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            },
            "example": 1
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "description": "Define the timeout, in ms",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            },
            "example": 1000
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/standard.GetShipmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/standard.Shipment"
                }
              }
            }
          }
        }
      }
    }
  },
